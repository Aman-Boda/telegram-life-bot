    {
      "parameters": {
        "jsCode": "const rawDescription = ($('Parse Classification').first().json.description || '').trim();\nconst description = rawDescription.toLowerCase();\nconst openTasks = items.filter(item => item.json.Status === 'Open');\n\nlet match;\nif (/^\\d+$/.test(rawDescription)) {\n  match = openTasks.find(t => String(t.json.ID) === rawDescription);\n} else {\n  match = openTasks.find(t => {\n    const taskText = (t.json.Task || '').toLowerCase();\n    return taskText.includes(description) || description.includes(taskText);\n  });\n}\n\nreturn [{\n  json: {\n    chat_id: $('Parse Classification').first().json.chat_id,\n    found: match ? \"true\" : \"false\",\n    task_id: match ? match.json.ID : null,\n    task_text: match ? match.json.Task : rawDescription\n  }\n}];"
      },
