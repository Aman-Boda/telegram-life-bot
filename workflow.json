    {
      "parameters": {
        "jsCode": "const expenseItems = $('Get Expenses').all(); const today = new Date().toISOString().slice(0, 10); let todayTotal = 0; let allTimeTotal = 0; for (const e of expenseItems) { const amt = parseFloat(e.json.Amount) || 0; allTimeTotal += amt; const expDate = (e.json.Timestamp || '').slice(0, 10); if (expDate === today) { todayTotal += amt; } } const openTasks = items.filter(t => t.json.Status === 'Open'); const taskLines = openTasks.length === 0 ? \"No open tasks.\" : openTasks.map(t => t.json.ID + '. ' + t.json.Task).join('\\n'); const message = \"Good morning! Here's your daily summary:\\n\\n\" + \"Spent today: \\u20b9\" + todayTotal + \"\\n\" + \"All-time total: \\u20b9\" + allTimeTotal + \"\\n\\n\" + \"Open tasks (\" + openTasks.length + \"):\\n\" + taskLines; return [{ json: { message } }];"
      },
