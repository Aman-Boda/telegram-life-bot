      "parameters": {
        "jsCode": "const openTasks = items.filter(item => item.json.Status === 'Open');\n\nlet message;\nif (openTasks.length === 0) {\n  message = \"You have no open tasks!\";\n} else {\n  const lines = openTasks.map(t => t.json.ID + '. ' + t.json.Task);\n  message = \"Your open tasks:\\n\" + lines.join('\\n');\n}\n\nreturn [{\n  json: {\n    chat_id: $('Parse Classification').first().json.chat_id,\n    reply_text: message\n  }\n}];"
      },
