      "parameters": {
        "jsCode": "const systemPrompt = \"You are a personal assistant bot. Classify the user's message into exactly one of: expense, task_add, task_list, task_complete, other. If it's an expense, extract the amount (number) and a short description. If it's task_add or task_complete, extract the task text as description. Respond with ONLY a valid JSON object with fields: type, amount (number or null), description (string or null). No text outside the JSON.\"; return items.map(item => { const userText = item.json.message.text; const requestBody = { systemInstruction: { parts: [ { text: systemPrompt } ] }, contents: [ { role: \"user\", parts: [ { text: userText } ] } ], generationConfig: { temperature: 0.2 } }; return { json: { ...item.json, chat_id: item.json.message.chat.id, user_text: userText, gemini_request_body: requestBody } }; });"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        0
      ],
      "id": "995d52ed-773c-473a-a7ff-91858b4e49b9",
      "name": "Build Classifier Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.6-flash:generateContent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.gemini_request_body) }}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        416,
        0
      ],
      "id": "6ac16894-d056-4919-bd58-d2333c22718a",
