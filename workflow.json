      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_YOUR_GEMINI_CREDENTIAL_ID",
          "name": "Gemini API Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return items.map((item, i) => {\n  const earlier = $('Build Classifier Request').all();\n  const chatId = earlier[i] ? earlier[i].json.chat_id : undefined;\n  const userText = earlier[i] ? earlier[i].json.user_text : undefined;\n\n  let parsed;\n  try {\n    parsed = JSON.parse(item.json.candidates[0].content.parts[0].text);\n  } catch (e) {\n    parsed = { type: 'other', amount: null, description: null };\n  }\n  const cleanType = (parsed.type || 'other').toString().trim().toLowerCase();\n\n  return { json: { chat_id: chatId, user_text: userText, type: cleanType, amount: parsed.amount, description: parsed.description } };\n});"
      },
